package com.fifa11.port;

import android.app.Activity;
import android.os.Build;
import android.os.Bundle;
import android.util.Log;

public class MainActivity extends Activity {

    private static final String TAG = "Fifa11Port";

    // Cargar la librería nativa compartida (.so)
    static {
        System.loadLibrary("fifa11_core");
    }

    // Método nativo declarado en C++ (main.cpp)
    public native void initResolution(int width, int height);

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);

        // 1. Detectar versión de Android y definir resolución dinámica
        int sdkVersion = Build.VERSION.SDK_INT;
        int targetWidth, targetHeight;

        if (sdkVersion <= Build.VERSION_CODES.O_MR1) { 
            // Android 5.0 (API 21) al 8.1 (Versiones de 32 bits enfocadas a rendimiento)
            targetWidth = 640;
            targetHeight = 360;
            Log.i(TAG, "Perfil Android 5-8: Resolucion configurada a 640x360 (Optimizada 32-bit)");
        } else if (sdkVersion <= Build.VERSION_CODES.VANILLA_ICE_CREAM) { 
            // Android 9 (API 28) hasta Android 14 / Android 15 inicial
            targetWidth = 1280;
            targetHeight = 720;
            Log.i(TAG, "Perfil Android 9-15: Resolucion configurada a 720p HD");
        } else { 
            // Android 15+ (Versiones modernas de 64 bits)
            targetWidth = 1920;
            targetHeight = 1080;
            Log.i(TAG, "Perfil Android 15+: Resolucion configurada a 1080p Full HD (64-bit)");
        }

        // 2. Llamar al motor nativo en C++ pasándole la resolución calculada
        initResolution(targetWidth, targetHeight);

        // Pantalla en blanco de prueba por ahora hasta montar OpenGL ES
        setContentView(new android.view.View(this));
    }
}